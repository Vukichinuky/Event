# PostgreSQL konekcija
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/svadbeni_bendovi"

# NextAuth — generiši sa: openssl rand -base64 32
AUTH_SECRET=""

# Početni admin nalog (koristi ga `npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Javna adresa sajta (za sitemap, robots, OG meta)
SITE_URL="http://localhost:3000"

# Folder za slike — VAN build foldera, bekapuje se (npr. /data/uploads na Mac Miniju)
UPLOAD_DIR="./data/uploads"

# Mejl (od Nedelje 5 — slanje upita bendu)
RESEND_API_KEY=""

# Adresa pošiljaoca (mora biti verifikovan domen na Resend-u)
EMAIL_FROM="Svadbeni bendovi <upiti@tvoj-domen.ba>"
